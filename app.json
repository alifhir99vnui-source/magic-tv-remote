{
  "expo": {
    "name": "Magic TV Remote",
    "slug": "magic-tv-remote",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "magic-tv-remote",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0C1115"
    },
    "ios": {
      "supportsTablet": false,
      "statusBarHidden": true
    },
    "android": {
      "package": "com.magicremote.tvremote",
      "versionCode": 4,
      "permissions": [
        "android.permission.ACCESS_LOCAL_NETWORK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withMagicHardware",
      "./plugins/withFullscreen",
      "./plugins/withNativeRemote",
      "./plugins/withBundledDebug"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b41ca113-37d2-4297-965a-41ac88a62c03"
      }
    },
    "owner": "murtaza979",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true
    }
  }
}
